# --- Supabase (javno, smije u preglednik) ---
# URL projekta: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (sb_publishable_...) ili legacy "anon" ključ
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (TAJNO, samo server — nikad s prefiksom NEXT_PUBLIC_) ---
# Secret (sb_secret_...) ili legacy "service_role" ključ
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Aplikacija ---
# Javni URL aplikacije (za QR kod, linkove u e-mailovima)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tajna za zaštitu cron rute za čišćenje (/api/cron/cleanup)
CRON_SECRET=promijeni-me-u-dugi-nasumicni-niz
